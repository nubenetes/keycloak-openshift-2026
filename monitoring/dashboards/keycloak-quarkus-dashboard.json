  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "HTTP Request Rate (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"keycloak\"}[1m])) by (status)",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Request Latency (p95 / p99)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{namespace=\"keycloak\"}[1m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{namespace=\"keycloak\"}[1m])) by (le))",
          "legendFormat": "p99 Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "JVM Heap Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_memory_used_bytes{namespace=\"keycloak\",area=\"heap\"} / 1024 / 1024",
          "legendFormat": "{{pod}} (Heap MB)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Agroal DB Connection Pool",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "agroal_active_count{namespace=\"keycloak\"}",
          "legendFormat": "{{pod}} Active DB Conns"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "agroal_max_count{namespace=\"keycloak\"}",
          "legendFormat": "{{pod}} Max DB Conns"
        }
      ]
    }
  ],
